# opkg-фид Invisible Net VPN+XOR (GitHub Pages).
# Скопируй этот файл на роутере в /opt/etc/opkg/invnet.conf:
#
#   mkdir -p /opt/etc/opkg
#   echo 'src/gz invnet https://invisible25.github.io/keenetic-vpn-xor' > /opt/etc/opkg/invnet.conf
#   opkg update
#   opkg install invnet          # ставит панель + XOR-openvpn + зависимости
#
# Обновление до новой версии:
#   opkg update && opkg upgrade invnet
#
# ВАЖНО: фид отдаётся по HTTPS (github.io). Если opkg ругается на TLS/сертификат —
# доставь поддержку HTTPS в Entware:
#   opkg install ca-bundle ca-certificates
# (обычно уже стоит; проверь `opkg list-installed | grep ca-`).
src/gz invnet https://invisible25.github.io/keenetic-vpn-xor
