#!/bin/sh
# invnet prerm — выполняется opkg ПЕРЕД удалением файлов пакета.
# $1: opkg передаёт причину — upgrade | remove | deconfigure.
#
# При upgrade НЕ рвём туннели: файлы штатно заменятся поверх (открытые процессом
# иноды переживают перезапись), postinst новой версии сам перезапустит web/шедулер/
# watchdog и сделает `reconcile` (он идемпотентен для уже поднятых туннелей — см.
# комментарий там). Раньше stopall дёргался безусловно — каждый рутинный
# `opkg upgrade invnet` ронял ВСЕ туннели разом на несколько секунд без необходимости.
[ "$1" = "upgrade" ] && exit 0

# Настоящее удаление — останавливаем службы и туннели. Пользовательские данные
# (профили, meta, конфиги, маршруты) НЕ трогаем — они не в манифесте пакета.
[ -x /opt/sbin/invnetctl ] && /opt/sbin/invnetctl stopall >/dev/null 2>&1
for s in S40invnet-pingcheck S41invnet-sched S31invnet-web; do
  /opt/etc/init.d/$s stop >/dev/null 2>&1
done

exit 0
