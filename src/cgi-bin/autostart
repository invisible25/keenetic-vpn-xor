#!/bin/sh
PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH
printf "Content-Type: text/plain\r\n\r\n"
. /opt/share/invnet/invnet-lib.sh
F=/opt/etc/openvpn/invnet-autostart.conf
if [ "$REQUEST_METHOD" = "POST" ]; then
  csrf_guard
  BODY=$(head -c 16)
  # точное сравнение, не подстрокой: старое "*1*" матчило любую цифру 1 в теле
  V=$(echo "$BODY" | tr -cd 'A-Za-z0-9')
  case "$V" in yes|true|on|1) echo yes > "$F" ;; *) echo no > "$F" ;; esac
fi
cat "$F" 2>/dev/null || echo no
