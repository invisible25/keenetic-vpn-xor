#!/bin/sh
PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH
printf "Content-Type: text/plain; charset=utf-8\r\n\r\n"
. /opt/share/invnet/invnet-lib.sh
csrf_guard
NAME=$(echo "$QUERY_STRING" | sed -n 's/.*name=\([^&]*\).*/\1/p' | tr -cd 'A-Za-z0-9._-')
[ -z "$NAME" ] && { echo "нужен ?name="; exit 1; }
# Блокируем удаление запущенного профиля (multi-profile: проверяем pid-файл)
PIDF="/opt/var/run/invnet/${NAME}.pid"
if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
  echo "нельзя удалить запущенный профиль: сначала выключи тумблер"; exit 1
fi
rm -f /opt/etc/openvpn/profiles/${NAME}.ovpn /opt/etc/openvpn/profile-meta/${NAME}.json
# Хвосты тоже: осиротевший .slot продолжал занимать один из 8 слотов в alloc_slot до
# ближайшего reconcile, а q-<name>.log ещё сутки держал удалённый профиль в «Качестве каналов».
rm -f "/opt/var/run/invnet/${NAME}.slot" "/opt/var/run/invnet/${NAME}.pid" \
      "/opt/var/log/invnet-${NAME}.log" "/opt/var/lib/invnet/q-${NAME}.log"
echo "удалён: $NAME"
