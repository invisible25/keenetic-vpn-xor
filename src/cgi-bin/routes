#!/bin/sh
PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH
printf "Content-Type: application/json; charset=utf-8\r\n\r\n"

F=/opt/etc/openvpn/invnet-routes.conf
LOCK=/opt/var/run/invnet-routes.lock

# Простой mkdir-lock (атомарен в любой fs). Ждём до 5 сек.
i=0
while ! mkdir "$LOCK" 2>/dev/null; do
  i=$((i+1)); [ "$i" -ge 50 ] && break; sleep 0.1 2>/dev/null || sleep 1
done
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

# Гарантируем валидную базу: если файл битый/пустой — стартуем с []
if ! jq -e '.' "$F" >/dev/null 2>&1; then
  echo '[]' > "$F"
fi

# Границы обязательны, и проверять их надо ЗДЕСЬ: панель без авторизации, фронтовый cidrOk
# доверенной границей не является. Прежняя регулярка пропускала «999.1.1.1/99» и, что важнее,
# «0.0.0.0/0» — одна такая запись отправляла ВЕСЬ форвардируемый трафик в таблицу туннеля,
# и падение туннеля глушило интернет всему LAN через blackhole.
is_valid_cidr() {
  echo "$1" | grep -qE '^([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\.([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3}(/([1-9]|[12][0-9]|3[0-2]))?$' || return 1
  case "$1" in 0.0.0.0/0|0.0.0.0) return 1 ;; esac   # дефолт-маршрут через панель не задаём
  return 0
}

. /opt/share/invnet/invnet-lib.sh

if [ "$REQUEST_METHOD" = "POST" ]; then
  csrf_guard
  BODY=$(head -c 65536)
  ACTION=$(echo "$BODY" | tr '&' '\n' | grep '^action=' | sed 's/^action=//' | tr -cd 'a-z')
  CIDR=$(echo "$BODY" | tr '&' '\n' | grep '^cidr=' | sed 's/^cidr=//' | sed 's/%2F/\//g; s/%2f/\//g; s/+/ /g' | tr -cd '0-9./')
  COMMENT_RAW=$(echo "$BODY" | tr '&' '\n' | grep '^comment=' | sed 's/^comment=//')
  COMMENT=$(urldecode "$COMMENT_RAW" | tr -d '"' | head -c 80)
  IDX=$(echo "$BODY" | tr '&' '\n' | grep '^index=' | sed 's/^index=//' | tr -cd '0-9')
  WAN_SEL=$(echo "$BODY" | tr '&' '\n' | grep '^wan=' | sed 's/^wan=//' | tr -cd 'A-Za-z0-9._-')

  # снять старые точечные iptables-правила прямых маршрутов ДО перезаписи конфига
  . /opt/etc/openvpn/invnet-fw.sh 2>/dev/null && invnet_fw_remove_directroutes 2>/dev/null

  case "$ACTION" in
    add)
      if ! is_valid_cidr "$CIDR"; then echo '{"error":"invalid cidr"}'; exit 0; fi
      jq --arg c "$CIDR" --arg cm "$COMMENT" \
        'if any(.[]?; .cidr == $c) then . else . + [{cidr:$c, comment:$cm, enabled:true}] end' \
        "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      ;;
    import)
      # bulk: data=<urlencoded JSON array of {cidr,comment}> — одна атомарная запись
      DATA_RAW=$(echo "$BODY" | tr '&' '\n' | grep '^data=' | sed 's/^data=//')
      DATA=$(urldecode "$DATA_RAW")
      if echo "$DATA" | jq -e 'type == "array"' >/dev/null 2>&1; then
        # Фильтруем CIDRs в shell (jq на роутере без regex)
        VALID_DATA=$(echo "$DATA" | jq -c '.[]' 2>/dev/null | while read -r item; do
          cidr=$(echo "$item" | jq -r '.cidr // ""' 2>/dev/null)
          is_valid_cidr "$cidr" && printf '%s\n' "$item"
        done | jq -sc '.' 2>/dev/null)
        [ -z "$VALID_DATA" ] && VALID_DATA='[]'
        jq --argjson incoming "$VALID_DATA" '
          . as $cur
          | reduce $incoming[] as $r ($cur;
              if ($r.cidr // "") == "" then .
              elif any(.[]?; .cidr == $r.cidr) then .
              else . + [{cidr:$r.cidr, comment:($r.comment // "Keenetic"), enabled:true}]
              end)
        ' "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      else
        echo '{"error":"bad data"}'; exit 0
      fi
      ;;
    delete)
      jq --argjson i "${IDX:-0}" 'del(.[$i])' "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      ;;
    deleteall)
      echo '[]' > "$F"
      ;;
    toggle)
      jq --argjson i "${IDX:-0}" 'if ($i>=0 and $i<length) then .[$i].enabled = (.[$i].enabled | not) else . end' "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      ;;
    setdir)
      # направление маршрута: wan пусто → через VPN; иначе → напрямую через этот WAN.
      # Проверка границ ($i<length): иначе `.[$i] |=` создал бы null-дырки в массиве.
      if [ -z "$WAN_SEL" ]; then
        jq --argjson i "${IDX:-0}" 'if ($i>=0 and $i<length) then .[$i] |= (.direct=false | del(.wan)) else . end' "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      else
        jq --argjson i "${IDX:-0}" --arg w "$WAN_SEL" 'if ($i>=0 and $i<length) then .[$i] |= (.direct=true | .wan=$w) else . end' "$F" > "$F.tmp" 2>/dev/null && jq -e '.' "$F.tmp" >/dev/null 2>&1 && mv "$F.tmp" "$F" || rm -f "$F.tmp"
      fi
      ;;
  esac
  /opt/sbin/invnetctl apply >/dev/null 2>&1
fi

cat "$F"
