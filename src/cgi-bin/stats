#!/bin/sh
# Трафик по активным tun_invnet*: суммарный + разбивка по слотам.
# Разбивка (dev) нужна герою «Обзора»: скорость встречных полос на каждой линии
# считается по ЕЁ туннелю. На общей сумме анимация врала бы про строку — линия
# простаивающего профиля бежала бы ровно так же, как у грузящего канал.
# Поля rx/tx/up сохранены как были: старый фронт продолжает работать.
PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH
printf "Content-Type: application/json; charset=utf-8\r\n\r\n"

RX=0; TX=0; PER=""; UP=false
for dev in /sys/class/net/tun_invnet*; do
  [ -d "$dev" ] || continue                       # глоб не раскрылся — туннелей нет
  slot=${dev##*/tun_invnet}
  case "$slot" in ''|*[!0-9]*) continue ;; esac   # только штатные имена, слот идёт в JSON-ключ
  r=$(cat "$dev/statistics/rx_bytes" 2>/dev/null)
  t=$(cat "$dev/statistics/tx_bytes" 2>/dev/null)
  r=${r:-0}; t=${t:-0}
  # sysfs может отдать пусто/мусор на исчезающем интерфейсе — иначе получим битый JSON
  case "$r" in ''|*[!0-9]*) r=0 ;; esac
  case "$t" in ''|*[!0-9]*) t=0 ;; esac
  UP=true
  RX=$((RX + r)); TX=$((TX + t))
  [ -n "$PER" ] && PER="$PER,"
  PER="$PER\"$slot\":{\"rx\":$r,\"tx\":$t}"
done

# Аптайм самого старого живого туннеля, СЕКУНДАМИ. Поле up булево и таким остаётся (контракт),
# но панель показывала его через форматтер длительности и потому вечно писала «0ч 0м».
# Возраст берём от времени старта процесса: поле 22 в /proc/<pid>/stat — это момент запуска
# в тиках от загрузки системы, вычитаем его из аптайма системы. USER_HZ на этих ядрах = 100.
UPTIME=0
SYS=$(cut -d' ' -f1 /proc/uptime 2>/dev/null); SYS=${SYS%%.*}
case "$SYS" in ''|*[!0-9]*) SYS=0 ;; esac
if [ "$SYS" -gt 0 ]; then
  for pf in /opt/var/run/invnet/*.pid; do
    [ -f "$pf" ] || continue
    pid=$(cat "$pf" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$pid" 2>/dev/null || continue
    grep -qa openvpn "/proc/$pid/cmdline" 2>/dev/null || continue   # pid мог переиспользоваться
    st=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)
    case "$st" in ''|*[!0-9]*) continue ;; esac
    age=$((SYS - st / 100))
    [ "$age" -lt 0 ] && age=0
    [ "$age" -gt "$UPTIME" ] && UPTIME=$age
  done
fi
printf '{"rx":%s,"tx":%s,"up":%s,"uptime":%s,"dev":{%s}}' "$RX" "$TX" "$UP" "$UPTIME" "$PER"
