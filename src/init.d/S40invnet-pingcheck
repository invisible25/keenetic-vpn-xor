#!/bin/sh
# Watchdog: перезапускает опавшие VPN-процессы (enabled=true, но pid мёртв).
# Тикает каждые 30 секунд. Не делает внешних ping — только kill -0 на pid-файл.
export PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin

PIDF=/opt/var/run/invnet-pingcheck.pid
LOG=/opt/var/log/invnet-pingcheck.log
MGR=/opt/sbin/invnetctl
META=/opt/etc/openvpn/profile-meta
PROFILES=/opt/etc/openvpn/profiles
RUN=/opt/var/run/invnet
QDIR=/opt/var/lib/invnet          # сэмплы качества канала: q-<profile>.log = "<epoch> <rtt> <loss>"
QMAX=2880                         # хранить сутки при тике 30с (2880×30с = 24ч)
QCONF=/opt/etc/openvpn/invnet-qping.conf   # цель пинга (по умолчанию 1.1.1.1)

rotate_if_big() {  # rotate_if_big <file> [max_bytes] [keep_bytes]
  f="$1"; max="${2:-1048576}"; keep="${3:-262144}"
  [ -f "$f" ] || return 0
  sz=$(wc -c < "$f" 2>/dev/null) || return 0
  [ "$sz" -gt "$max" ] 2>/dev/null || return 0
  tail -c "$keep" "$f" > "$f.tmp" 2>/dev/null && cat "$f.tmp" > "$f" && rm -f "$f.tmp"
}

rotate_logs() {
  # Без ограничения размера лог openvpn (--log-append) может залить весь USB-диск,
  # если туннель зависнет в цикле ошибок (напр. "tun fd in bad state" без паузы между
  # попытками) — так один раз забился весь раздел Entware и упала вся панель.
  # Глобом по /opt/var/log/invnet-*.log (а не только по текущим slot-файлам), чтобы
  # ловить и логи ОСТАНОВЛЕННЫХ/удалённых профилей — они тоже копятся годами без ротации.
  for f in /opt/var/log/invnet-*.log; do
    rotate_if_big "$f"
  done
  rotate_if_big "/opt/var/log/invnet-web.err"
}

# Замер качества канала: по каждому ЗАПУЩЕННОМУ туннелю пингуем цель ЧЕРЕЗ туннель
# (bind к tun_invnet<slot>), пишем rtt/потери. Данные для вкладки «Диагностика».
# Пассивно — на логику перезапуска (kill -0) не влияет.
sample_quality() {
  mkdir -p "$QDIR"
  # tr -cd '0-9.' из хостнейма делает мусор («ping.example.com» → «..»), который непуст,
  # поэтому дефолт не подставлялся и ВСЕ сэмплы качества навсегда шли как 100% потерь.
  # Принимаем только то, что похоже на IPv4; иначе — дефолт.
  target=$(tr -cd '0-9.' < "$QCONF" 2>/dev/null)
  case "$target" in
    [0-9]*.[0-9]*.[0-9]*.[0-9]*) case "$target" in *..*|*.) target=1.1.1.1 ;; esac ;;
    *) target=1.1.1.1 ;;
  esac
  for slotf in "$RUN"/*.slot; do
    [ -f "$slotf" ] || continue
    pr=$(basename "$slotf" .slot)
    PID=$(cat "$RUN/$pr.pid" 2>/dev/null)
    { [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; } || continue     # только живые
    dev="tun_invnet$(cat "$slotf" 2>/dev/null)"
    ip link show "$dev" >/dev/null 2>&1 || continue
    out=$(ping -c 3 -W 2 -I "$dev" "$target" 2>/dev/null)
    loss=$(echo "$out" | sed -n 's/.*[^0-9]\([0-9]\{1,3\}\)% packet loss.*/\1/p' | head -1)
    rtt=$(echo "$out"  | sed -n 's#.* = [0-9.]*/\([0-9.]*\)/.*#\1#p' | head -1)
    [ -z "$loss" ] && loss=100          # ping не отработал = считаем потерей
    qf="$QDIR/q-$pr.log"
    # rtt пустым не пишем: "<ts>  100" (двойной пробел) даёт в quality awk $2=100 $3=""
    # → loss читается как 0, а не как 100. Плейсхолдер "-" — quality уже ждёт именно его.
    echo "$(date +%s) ${rtt:--} $loss" >> "$qf"
    ln=$(wc -l < "$qf" 2>/dev/null || echo 0)
    [ "$ln" -gt "$QMAX" ] 2>/dev/null && { tail -n "$QMAX" "$qf" > "$qf.tmp" 2>/dev/null && mv "$qf.tmp" "$qf"; }
  done
}

watchdog_loop() {
  while true; do
    rotate_logs
    for meta in "$META"/*.json; do
      [ -f "$meta" ] || continue
      pr=$(basename "$meta" .json)
      [ -f "$PROFILES/$pr.ovpn" ] || continue
      [ "$(jq -r '.enabled // false' "$meta" 2>/dev/null)" = "true" ] || continue
      PID=$(cat "$RUN/$pr.pid" 2>/dev/null)
      if ! { [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; }; then
        echo "[$(date '+%F %T')] [$pr] процесс мёртв — перезапуск" >> "$LOG"
        "$MGR" start-one "$pr" >> "$LOG" 2>&1
        sleep 2
        "$MGR" apply >> "$LOG" 2>&1
        echo "[$(date '+%F %T')] [$pr] перезапуск завершён" >> "$LOG"
      fi
    done
    # defense-in-depth: вернуть fw/routing, если NDM перестроил netfilter между
    # событиями. Хук netfilter.d возвращает iptables мгновенно; здесь — страховка
    # раз в тик и для iptables, и для ip rule/маршрутов (их хук не покрывает).
    . /opt/etc/openvpn/invnet-fw.sh 2>/dev/null && invnet_fw_assert_all
    "$MGR" apply >/dev/null 2>&1
    sample_quality      # замер качества каналов (после перезапусков — по реально живым)
    sleep 30
  done
}

case "$1" in
  start)
    # Сверка cmdline обязательна: /opt/var/run переживает перезагрузку, и PID из старого
    # pid-файла с высокой вероятностью занят ЧУЖИМ процессом — тогда kill -0 успешен, и
    # watchdog молча не стартует. А без него нет ротации логов (именно её отсутствие забило
    # раздел на 12.5ГБ), нет возврата правил после перестроек NDM и нет перезапуска упавших
    # туннелей. S31 и S41 такую сверку уже делают, здесь её не было.
    if [ -f "$PIDF" ]; then
      _p=$(cat "$PIDF" 2>/dev/null)
      case "$_p" in ''|*[!0-9]*) _p="" ;; esac
      if [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null &&
         grep -qa 'S40invnet-pingcheck' "/proc/$_p/cmdline" 2>/dev/null; then
        exit 0
      fi
      rm -f "$PIDF"                     # стейл-файл, иначе он и дальше будет вводить в заблуждение
    fi
    mkdir -p "$RUN"
    watchdog_loop &
    echo $! > "$PIDF"
    echo "invnet-pingcheck started (pid=$(cat "$PIDF"))"
    ;;
  stop)
    [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null
    rm -f "$PIDF"
    echo "invnet-pingcheck stopped"
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
  status)
    if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
      echo "running (pid=$(cat "$PIDF"))"
    else
      echo "stopped"
    fi
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status}"; exit 1
    ;;
esac
