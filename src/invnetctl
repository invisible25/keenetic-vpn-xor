#!/bin/sh
# invnetctl — оркестратор нескольких VPN+XOR профилей одновременно.
#
# Модель (Вариант А — по устройствам):
#   • каждый ВКЛЮЧЁННЫЙ профиль = свой openvpn-процесс на tun_invnet<slot> + таблица 101+slot
#   • устройства/CIDR профиля → ip rule from/to ... lookup <table>
#   • источник истины «включён ли профиль» — ключ "enabled" в profile-meta/<name>.json
#
# Команды:
#   invnetctl enable  <profile>   — пометить enabled + reconcile
#   invnetctl disable <profile>   — снять enabled + reconcile
#   invnetctl reconcile           — привести факт к желаемому (старт/стоп инстансов) + правила
#   invnetctl apply               — только переразложить ip rule (devices/routesменялись)
#   invnetctl stopall             — остановить все инстансы
#   invnetctl status              — JSON со всеми профилями и их состоянием
#   invnetctl schedule-tick       — исполнить события расписаний с прошлого тика (зовёт S41)
#   invnetctl schedule-sync [p]   — привести enabled к расписанию (старт демона/правка)

export PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
. /opt/etc/openvpn/invnet-fw.sh 2>/dev/null   # общий источник iptables-правил (assert/remove)

CONF=/opt/etc/openvpn
PROFILES=$CONF/profiles
META=$CONF/profile-meta
ROUTES_FILE=$CONF/invnet-routes.conf
WANPOL=$CONF/invnet-wan-policy.conf
RUN=/opt/var/run/invnet
LOGDIR=/opt/var/log
BIN=/opt/sbin/openvpn
UP=$CONF/invnet-up.sh
DOWN=$CONF/invnet-down.sh
MAXSLOT=7
LANIF="br0 br1"
HOLD_TABLE=199   # blackhole-удержание VPN-маршрутов, осиротевших без живого туннеля (анти-утечка)

mkdir -p "$RUN" "$META" "$LOGDIR"

# ---- helpers ----
meta_get() { jq -r "$2 // empty" "$META/$1.json" 2>/dev/null; }

is_enabled() { [ "$(meta_get "$1" '.enabled')" = "true" ]; }

set_meta_enabled() {
  if [ -f "$META/$1.json" ]; then
    jq ".enabled=$2" "$META/$1.json" > "$META/$1.json.tmp" 2>/dev/null \
    && jq -e '.' "$META/$1.json.tmp" >/dev/null 2>&1 \
    && mv "$META/$1.json.tmp" "$META/$1.json" || rm -f "$META/$1.json.tmp"
  else
    echo "{\"enabled\":$2}" > "$META/$1.json"
  fi
}

slot_of() { cat "$RUN/$1.slot" 2>/dev/null; }

pid_of() { cat "$RUN/$1.pid" 2>/dev/null; }

is_running() {
  # /opt/var/run переживает перезагрузку (persistent-раздел) — pid-файл может
  # пережить процесс, чей PID после ребута выдан чему-то другому. kill -0 сам по
  # себе это не отличит, поэтому дополнительно сверяем, что это правда openvpn.
  P=$(pid_of "$1"); [ -n "$P" ] || return 1
  kill -0 "$P" 2>/dev/null || return 1
  grep -qa openvpn "/proc/$P/cmdline" 2>/dev/null
}

used_slots() { cat "$RUN"/*.slot 2>/dev/null; }

alloc_slot() {
  # уже есть — вернуть
  s=$(slot_of "$1"); [ -n "$s" ] && { echo "$s"; return; }
  used=" $(used_slots | tr '\n' ' ') "
  i=0
  while [ "$i" -le "$MAXSLOT" ]; do
    case "$used" in *" $i "*) : ;; *) echo "$i" > "$RUN/$1.slot"; echo "$i"; return;; esac
    i=$((i+1))
  done
  return 1   # нет свободных слотов
}

# ---- определить WAN профиля: явный из meta, иначе авто (физ. uplink Keenetic) ----
# Авто берёт интерфейс с флагом defaultgw=true из NDM RCI (это ISP-аплинк, НЕ
# policy-VPN), маппит address→Linux-устройство. Нужно, чтобы openvpn выходил к
# своему серверу через физический WAN, даже когда штатный VPN Keenetic — default.
resolve_wan() {
  W=$(meta_get "$1" '.wan'); [ -n "$W" ] && { echo "$W"; return; }
  IFJSON=$(curl -s --max-time 3 http://127.0.0.1:79/rci/show/interface 2>/dev/null)
  [ -z "$IFJSON" ] && return
  ADDR=$(echo "$IFJSON" | jq -r 'to_entries[]|.value|select((.defaultgw//false)==true and (.connected//"no")=="yes")|.address // empty' 2>/dev/null | head -1)
  [ -z "$ADDR" ] && return
  ip -o -4 addr show 2>/dev/null | awk -v a="$ADDR" 'index($4,a"/")==1{print $2; exit}'
}

# ---- шлюз физического WAN-устройства (для policy-таблиц процесса и WAN-политики) ----
# Сперва via на самом dev, затем via в table main для этого dev; для PPP/p2p
# (PPPoE/SSTP/L2TP) шлюза нет — вызывающий тогда кладёт default dev <wan>.
wan_gw() {
  _w=$1
  _gw=$(ip -4 route show dev "$_w" 2>/dev/null | sed -n 's/.*[[:space:]]via[[:space:]]\([0-9.]\{1,\}\).*/\1/p' | head -1)
  [ -z "$_gw" ] && _gw=$(ip -4 route show table main 2>/dev/null | sed -n "s|.*via[[:space:]]\([0-9.]\{1,\}\)[[:space:]]dev[[:space:]]$_w\([[:space:]].*\)\?\$|\1|p" | head -1)
  # Шлюз ВТОРИЧНОГО Ethernet-WAN может отсутствовать в main-таблице (default там
  # держит основной канал). NDM знает шлюз — спросим у RCI по адресу интерфейса, но
  # curl дорог в тике S40 → КЭШИРУЕМ результат ($RUN/gw.<wan>) и читаем кэш до curl.
  # Для PPP/PPPoE (ADSL) шлюз не нужен (p2p, выход через сам dev) — НЕ дёргаем RCI.
  if [ -z "$_gw" ]; then
    case "$_w" in
      ppp*) : ;;
      *)
        _cache="$RUN/gw.$_w"
        if [ -s "$_cache" ]; then
          _gw=$(cat "$_cache" 2>/dev/null)
        else
          _a=$(ip -4 -o addr show dev "$_w" 2>/dev/null | awk '{split($4,x,"/");print x[1];exit}')
          [ -n "$_a" ] && _gw=$(curl -s --max-time 3 http://127.0.0.1:79/rci/show/interface 2>/dev/null \
              | jq -r --arg a "$_a" 'to_entries[]|.value|select(.address==$a)|.gateway // empty' 2>/dev/null | head -1)
          [ -n "$_gw" ] && { mkdir -p "$RUN" 2>/dev/null; echo "$_gw" > "$_cache"; }
        fi
        ;;
    esac
  fi
  echo "$_gw"
}

# ---- лок на профиль: сериализует start_one/stop_one ОДНОГО профиля ----
# Без него параллельные invnetctl (напр. CGI форкает stop-one, а через пару секунд
# следом start-one — оба процесса независимы) дерутся за pid/slot/tun-интерфейс:
# старый openvpn может ещё не умереть (в т.ч. застрять в D-state после kill -9),
# а start_one() тем временем форсированно удаляет "чужой" tun и поднимает новый
# процесс на том же имени — старый получает fd в bad state и уходит в busy-loop
# записи ошибки в лог (живой инцидент 88.1, 2026-07-27). mkdir — атомарный лок,
# по образцу apply(); срыв по таймауту — чтобы не зависнуть навсегда, если
# держатель лока сам застрял.
PLOCK_TIMEOUT=45
profile_lock() {
  _lk="$RUN/$1.lock"; _n=0
  while ! mkdir "$_lk" 2>/dev/null; do
    _n=$((_n+1))
    [ "$_n" -ge "$PLOCK_TIMEOUT" ] && { echo "[$1] лок занят >${PLOCK_TIMEOUT}с — снимаю принудительно" >&2; rmdir "$_lk" 2>/dev/null; break; }
    sleep 1
  done
}
profile_unlock() { rmdir "$RUN/$1.lock" 2>/dev/null; }

# ---- запуск одного профиля ----
start_one() {
  PROFILE=$1
  CFG="$PROFILES/$PROFILE.ovpn"
  [ -f "$CFG" ] || { echo "[$PROFILE] нет конфига"; return 1; }
  is_running "$PROFILE" && return 0

  profile_lock "$PROFILE"
  # пока ждали лок, состояние могло смениться (stop_one уже добил процесс и
  # снял слот, либо параллельный start_one уже поднял профиль) — перепроверяем
  if is_running "$PROFILE"; then profile_unlock "$PROFILE"; return 0; fi

  SLOT=$(alloc_slot "$PROFILE") || { echo "[$PROFILE] нет свободных слотов"; profile_unlock "$PROFILE"; return 1; }
  DEV="tun_invnet$SLOT"
  PIDF="$RUN/$PROFILE.pid"
  LOGF="$LOGDIR/invnet-$PROFILE.log"

  # снять застрявший интерфейс этого слота
  n=0
  while ip link show "$DEV" >/dev/null 2>&1; do
    ip link set "$DEV" down 2>/dev/null; ip link delete "$DEV" 2>/dev/null
    n=$((n+1)); [ "$n" -ge 20 ] && break; sleep 0.2 2>/dev/null || sleep 1
  done

  # WAN-policy: трафик самого процесса openvpn к VPN-серверу должен выходить
  # через выбранный физический WAN, даже когда штатный VPN Keenetic стал
  # default-route. Иначе исходящий UDP уходит в Keenetic-VPN → TLS timeout.
  WAN=$(resolve_wan "$PROFILE")     # явный из meta или авто (физ. uplink)
  WAN_ARGS=""
  if [ -n "$WAN" ]; then
    PRIO=$((30 + SLOT))             # ниже политик Keenetic (fwmark prio 100-110)
    WTABLE=$((201 + SLOT))
    WMARK=$((4100 + SLOT))
    while ip rule del priority "$PRIO" 2>/dev/null; do :; done
    ip route flush table "$WTABLE" 2>/dev/null

    # Шлюз WAN: ищем ЛЮБОЙ via на интерфейсе (default может забрать Keenetic-VPN),
    # для PPP/p2p (PPPoE/SSTP/L2TP) шлюз не нужен — выход через сам dev.
    GW=$(wan_gw "$WAN")
    if [ -n "$GW" ]; then
      ip route replace default via "$GW" dev "$WAN" table "$WTABLE" 2>/dev/null
    else
      ip route replace default dev "$WAN" table "$WTABLE" 2>/dev/null
    fi

    # ОСНОВНОЙ механизм: правило по АДРЕСУ VPN-сервера. Сопоставляется на этапе
    # FIB по dst — иммунно к затиранию метки, бьёт политики Keenetic (prio<100).
    for r in $(grep -E '^[[:space:]]*remote[[:space:]]' "$CFG" 2>/dev/null | awk '{print $2}' | sort -u); do
      case "$r" in
        *[a-zA-Z]*) IP=$(timeout 5 nslookup "$r" 2>/dev/null | awk '/^Address[ :]/{print $NF}' | grep -E '^[0-9.]+$' | grep -vE '^127\.' | head -1) ;;
        *)          IP="$r" ;;
      esac
      [ -n "$IP" ] && ip rule add to "$IP" lookup "$WTABLE" priority "$PRIO" 2>/dev/null
    done

    # ВТОРИЧНЫЙ механизм (catch-all для hostname/непредсказуемых IP): SO_MARK от
    # openvpn → fwmark-правило. Работает, т.к. NDM не метит router-originated OUTPUT.
    ip rule add fwmark "$WMARK" lookup "$WTABLE" priority "$PRIO" 2>/dev/null
    WAN_ARGS="--mark $WMARK"
  fi

  # слот мог остаться от прежнего владельца (краш / kill -9 без down-хука) —
  # снять его iptables, чтобы новый профиль не унаследовал чужой MASQUERADE/FORWARD
  invnet_fw_remove_dev "$DEV"

  "$BIN" \
    --config "$CFG" \
    --dev "$DEV" --dev-type tun \
    --setenv INVNET_PROFILE "$PROFILE" \
    --setenv INVNET_SLOT "$SLOT" \
    --daemon "invnet-$PROFILE" --writepid "$PIDF" --log-append "$LOGF" \
    --script-security 2 \
    --route-nopull \
    --pull-filter ignore "redirect-gateway" \
    --pull-filter ignore "route" \
    --pull-filter ignore "dhcp-option" \
    --pull-filter ignore "ping" \
    --pull-filter ignore "ping-restart" \
    --keepalive 10 60 \
    --persist-key \
    --persist-tun \
    $WAN_ARGS \
    --up "$UP" --down "$DOWN"
  profile_unlock "$PROFILE"
  echo "[$PROFILE] start slot=$SLOT dev=$DEV"
}

# ---- остановка одного профиля ----
stop_one() {
  PROFILE=$1
  profile_lock "$PROFILE"
  SLOT=$(slot_of "$PROFILE")
  P=$(pid_of "$PROFILE")
  [ -n "$P" ] && kill "$P" 2>/dev/null
  # Ждём РЕАЛЬНОЙ смерти процесса (kill -0 подтверждает не только память о pid,
  # но и что это до сих пор живой процесс), не просто факта отправки kill -9.
  # После kill -9 процесс может уйти в D-state (блокирующий syscall на битом
  # tun/диске) — kill -0 продолжит видеть его, пока ядро само не отпустит.
  # Бесконечно ждать нельзя (аппаратная проблема — D-state навсегда), поэтому
  # верхний потолок ~45с; если не дождались — идём дальше принудительно, но
  # громко предупреждаем в лог (тот, кто держит интерфейс, может ещё быть жив).
  i=0
  while [ -n "$P" ] && kill -0 "$P" 2>/dev/null; do
    i=$((i+1))
    [ "$i" -ge 6 ] && kill -9 "$P" 2>/dev/null
    if [ "$i" -ge 45 ]; then
      echo "[$PROFILE] pid=$P не завершился за ${i}с (похоже на D-state) — снимаю интерфейс принудительно" >&2
      break
    fi
    sleep 1
  done
  rm -f "$RUN/$PROFILE.pid"
  if [ -n "$SLOT" ]; then
    TABLE=$((101 + SLOT))
    WTABLE=$((201 + SLOT))
    PRIOW=$((30 + SLOT))
    while ip rule del table "$TABLE" 2>/dev/null; do :; done
    while ip rule del priority "$PRIOW" 2>/dev/null; do :; done
    ip route flush table "$TABLE" 2>/dev/null
    ip route flush table "$WTABLE" 2>/dev/null
    DEV="tun_invnet$SLOT"
    invnet_fw_remove_dev "$DEV"
    ip link show "$DEV" >/dev/null 2>&1 && ip link delete "$DEV" 2>/dev/null
  fi
  rm -f "$RUN/$PROFILE.slot"
  profile_unlock "$PROFILE"
  echo "[$PROFILE] stop"
}

# ---- реконсиляция ip rule без гэпа (make-before-break) ----
# apply_one/apply_routes/apply_wan_policy раньше чистили всю полосу приоритетов и
# заново отстраивали её циклом add — между del и последним add у устройства/CIDR
# не было ни одного правила (окно 100-400мс на реальных списках, каждый add — форк),
# пакет мог проскочить мимо kill-switch на fwmark-политики Keenetic/main-таблицу.
# Вместо этого: 1) один снимок ip rule на весь apply() (полосы функций не
# пересекаются — 39/40, 50+slot/70+slot, 60-69 — общий снимок безопасен для всех);
# 2) хеш желаемого состояния + живой счётчик правил — если оба совпадают с прошлым
# успешным прогоном, вообще ничего не трогаем (устраняет почти все окна — обычные
# тики watchdog раз в 30с, когда ничего не менялось); живой счётчик обязателен
# отдельно от хеша: $RUN — persistent-раздел (переживает ребут), а ip rule в ядре —
# нет, без этой проверки kill-switch после ребута тихо остался бы не восстановлен;
# 3) если отличается — СНАЧАЛА добавить недостающее, ПОТОМ убрать лишнее: хотя бы
# одно правило существует непрерывно, в т.ч. при смене режима profile devices↔all
# (это две разные полосы — новая появляется раньше, чем старая исчезает).
rules_snapshot() { RULES_NOW=$(ip rule show 2>/dev/null); }

# Тело правил на приоритете $1 (без "N:\t"), по строке на правило.
# " [detached]" вырезаем: ядро добавляет эту пометку для правила, чей iif сейчас
# не поднят (br1 в бридже без клиентов). С ней строка не совпала бы с желаемой
# (лишний add-дубликат), а `ip rule del` с этим словом в аргументах — синтаксическая
# ошибка, и правило не удалялось бы никогда. Без пометки del отрабатывает штатно.
rule_lines_at() {
  [ -n "$RULES_NOW" ] || rules_snapshot
  printf '%s\n' "$RULES_NOW" \
    | awk -v p="$1:" '$1==p{ $1=""; sub(/^ +/,""); sub(/ \[detached\]/,""); print }'
}
rule_count_at() { rule_lines_at "$1" | grep -c .; }

# Добавить то, чего нет среди текущих правил на приоритете $1, но есть в файле
# желаемых строк $2 (одна строка — одно правило, БЕЗ приоритета в строке).
# set -- разбивает строку на позиционные параметры так же надёжно, как явное
# квотирование поле-за-полем в прежнем коде — просто число полей заранее неизвестно.
rule_add_missing() {
  _prio=$1; _wantfile=$2
  _cur="$RUN/.rc_cur.$$"
  rule_lines_at "$_prio" > "$_cur"
  grep -vxFf "$_cur" "$_wantfile" 2>/dev/null | while IFS= read -r _w; do
    [ -z "$_w" ] && continue
    set -- $_w
    ip rule add "$@" priority "$_prio" 2>/dev/null
  done
  rm -f "$_cur"
}

# Убрать то, что сейчас есть на приоритете $1, но чего больше нет в файле
# желаемых строк $2. Вызывать ТОЛЬКО после rule_add_missing на всех полосах,
# которые в этом прогоне получают новые правила — иначе получим обратный
# (небезопасный) порядок break-before-make.
rule_remove_stale() {
  _prio=$1; _wantfile=$2
  rule_lines_at "$_prio" | grep -vxFf "$_wantfile" 2>/dev/null | while IFS= read -r _c; do
    [ -z "$_c" ] && continue
    set -- $_c
    ip rule del "$@" priority "$_prio" 2>/dev/null
  done
}

hashof() { md5sum 2>/dev/null | awk '{print $1}'; }

# ---- разложить ip rule для одного профиля (по его meta + глобальным CIDR) ----
apply_one() {
  PROFILE=$1
  SLOT=$(slot_of "$PROFILE"); [ -z "$SLOT" ] && return 0
  DEV="tun_invnet$SLOT"; TABLE=$((101 + SLOT))
  ip link show "$DEV" >/dev/null 2>&1 || return 0

  # default в таблицу профиля — атомарно (replace), без flush; дёшево — переутверждаем
  # безусловно, без хеш-гейта (иначе между flush и add таблица пуста → утечка мимо VPN).
  ip route replace default dev "$DEV" table "$TABLE" 2>/dev/null
  ip route replace blackhole default table "$TABLE" metric 9999 2>/dev/null  # kill-switch fallback

  # Приоритеты ниже 100 — чтобы перебить fwmark-правила Keenetic (политики доступа, prio 100-110).
  P_DEV=$((50 + SLOT)); P_ALL=$((70 + SLOT))
  MODE=$(meta_get "$PROFILE" '.mode'); [ -z "$MODE" ] && MODE=devices

  WF_ALL="$RUN/.want_all.$PROFILE"; WF_DEV="$RUN/.want_dev.$PROFILE"
  : > "$WF_ALL"; : > "$WF_DEV"
  if [ "$MODE" = "all" ]; then
    for L in $LANIF; do echo "from all iif $L lookup $TABLE"; done > "$WF_ALL"
  else
    # sed, а НЕ `tr -d '[:space:]'`: tr работает на всём потоке и схлопнул бы
    # переводы строк — весь список адресов слипся бы в одну мусорную строку
    # (в прежнем коде tr стоял внутри while read, т.е. построчно).
    meta_get "$PROFILE" '.devices[]?' | sed 's/[[:space:]]//g' | grep -v '^$' | sort -u \
      | awk -v t="$TABLE" '{print "from " $0 " lookup " t}' > "$WF_DEV"
  fi

  EXP_ALL=$(grep -c . "$WF_ALL"); EXP_DEV=$(grep -c . "$WF_DEV")
  NEWHASH=$(cat "$WF_ALL" "$WF_DEV" | hashof)
  HF="$RUN/$PROFILE.applyhash"
  OLDHASH=$(cat "$HF" 2>/dev/null)

  if [ "$NEWHASH" = "$OLDHASH" ] \
     && [ "$(rule_count_at "$P_ALL")" = "$EXP_ALL" ] \
     && [ "$(rule_count_at "$P_DEV")" = "$EXP_DEV" ]; then
    rm -f "$WF_ALL" "$WF_DEV"
    return 0   # желаемое не менялось, живое состояние ему соответствует
  fi

  rule_add_missing "$P_ALL" "$WF_ALL"
  rule_add_missing "$P_DEV" "$WF_DEV"
  rule_remove_stale "$P_ALL" "$WF_ALL"
  rule_remove_stale "$P_DEV" "$WF_DEV"

  rm -f "$WF_ALL" "$WF_DEV"
  echo "$NEWHASH" > "$HF"
}

# ---- rp_filter: ослабить строгую reverse-path проверку на канале (1→2 loose) ----
# При policy-routing обратный пакет приходит на «не тот по main-таблице» интерфейс и
# строгий rp_filter (1) его дропнет. Меняем ТОЛЬКО если строгий, сохраняя оригинал
# в $RUN/rpf.<wan> для отката. На роутерах с rp_filter=0 (off) не трогаем вовсе.
rpf_ensure_loose() {
  _w=$1; _p="/proc/sys/net/ipv4/conf/$_w/rp_filter"
  [ -w "$_p" ] || return 0
  _cur=$(cat "$_p" 2>/dev/null)
  if [ "$_cur" = "1" ]; then
    [ -f "$RUN/rpf.$_w" ] || echo "$_cur" > "$RUN/rpf.$_w"
    echo 2 > "$_p" 2>/dev/null
  fi
}
# Вернуть исходный rp_filter каналам, которые больше не используются ни WAN-политикой,
# ни прямыми маршрутами.
rpf_restore_unused() {
  for _rf in "$RUN"/rpf.*; do
    [ -f "$_rf" ] || continue
    _w=$(basename "$_rf"); _w=${_w#rpf.}
    _used=no
    [ -f "$WANPOL" ] && jq -e --arg w "$_w" 'any(.[]?; (.enabled != false) and (.wan == $w) and ((.devices|length) > 0))' "$WANPOL" >/dev/null 2>&1 && _used=yes
    [ -f "$ROUTES_FILE" ] && jq -e --arg w "$_w" 'any(.[]?; (.enabled != false) and (.direct == true) and (.wan == $w))' "$ROUTES_FILE" >/dev/null 2>&1 && _used=yes
    if [ "$_used" = no ]; then
      _p="/proc/sys/net/ipv4/conf/$_w/rp_filter"
      [ -w "$_p" ] && cat "$_rf" > "$_p" 2>/dev/null
      rm -f "$_rf"
    fi
  done
}

# ---- CIDR-маршруты: через VPN (primary активный профиль) ИЛИ напрямую (физ. WAN) ----
# Направление маршрута: .direct==true → подсеть идёт МИМО VPN через .wan (как
# статический маршрут-исключение в Keenetic). Прямой маршрут prio 39 перебивает
# привязку устройства к VPN (prio 50) → исключение работает даже для VPN-устройства.
# Иначе (.direct≠true) → подсеть В VPN через primary-профиль (prio 40).
apply_routes() {
  _t=230; while [ "$_t" -le 238 ]; do ip route flush table "$_t" 2>/dev/null; _t=$((_t+1)); done
  ip route flush table "$HOLD_TABLE" 2>/dev/null   # снять прошлое blackhole-удержание

  WF39="$RUN/.want39"; WF40="$RUN/.want40"
  : > "$WF39"; : > "$WF40"

  if [ -f "$ROUTES_FILE" ]; then
    # ── ПРЯМЫЕ маршруты-исключения: <cidr> через физический WAN, минуя VPN ──
    # таблицы 230+j (j по числу разных WAN-каналов исключений), правила prio 39.
    j=0
    for w in $(jq -r '.[] | select(.enabled != false and .direct == true) | .wan // empty' "$ROUTES_FILE" 2>/dev/null | sort -u); do
      [ -z "$w" ] && continue
      ip link show "$w" >/dev/null 2>&1 || continue
      [ "$j" -gt 8 ] && break
      DT=$((230 + j)); j=$((j+1))
      rpf_ensure_loose "$w"
      GW=$(wan_gw "$w")
      if [ -n "$GW" ]; then ip route replace default via "$GW" dev "$w" table "$DT" 2>/dev/null
      else ip route replace default dev "$w" table "$DT" 2>/dev/null; fi
      jq -r --arg w "$w" '.[] | select(.enabled != false and .direct == true and ((.wan // "") == $w)) | .cidr' "$ROUTES_FILE" 2>/dev/null \
      | while read -r cidr; do
          cidr=$(echo "$cidr" | tr -d '[:space:]'); [ -z "$cidr" ] && continue
          echo "from all to $cidr lookup $DT"
        done >> "$WF39"
    done

    # ── маршруты ЧЕРЕЗ VPN: через primary (минимальный slot) активный профиль ──
    PRIMARY=""; MINSLOT=99
    for sf in "$RUN"/*.slot; do
      [ -f "$sf" ] || continue
      pr=$(basename "$sf" .slot); s=$(cat "$sf")
      is_running "$pr" || continue
      [ "$s" -lt "$MINSLOT" ] && { MINSLOT=$s; PRIMARY=$pr; }
    done
    VPN_CIDRS=$(jq -r '.[] | select(.enabled != false and ((.direct // false) != true)) | .cidr' "$ROUTES_FILE" 2>/dev/null)
    if [ -n "$VPN_CIDRS" ]; then
      if [ -n "$PRIMARY" ]; then
        TABLE=$((101 + MINSLOT))                # есть живой туннель → подсети идут в VPN
      else
        # НЕТ живого туннеля-носителя (все профили выкл/удалены): держим VPN-маршруты в
        # blackhole, а НЕ выпускаем мимо VPN через обычный WAN (это была бы утечка — трафик
        # к «VPN-only» подсетям светился бы в открытый канал). Осиротевший маршрут остаётся
        # «в силе» так же, как kill-switch держит устройства (prio 40, отдельная таблица).
        TABLE=$HOLD_TABLE
        ip route replace blackhole default table "$HOLD_TABLE" 2>/dev/null
      fi
      printf '%s\n' "$VPN_CIDRS" | while read -r cidr; do
        cidr=$(echo "$cidr" | tr -d '[:space:]'); [ -z "$cidr" ] && continue
        echo "from all to $cidr lookup $TABLE"
      done >> "$WF40"
    fi
  fi

  EXP39=$(grep -c . "$WF39"); EXP40=$(grep -c . "$WF40")
  # хеш уже включает table для VPN-CIDR (PRIMARY/HOLD_TABLE) — это часть строки в WF40
  NEWHASH=$(cat "$WF39" "$WF40" | hashof)
  HF="$RUN/.routes.applyhash"
  OLDHASH=$(cat "$HF" 2>/dev/null)

  if [ "$NEWHASH" = "$OLDHASH" ] \
     && [ "$(rule_count_at 39)" = "$EXP39" ] \
     && [ "$(rule_count_at 40)" = "$EXP40" ]; then
    rm -f "$WF39" "$WF40"
    return 0
  fi

  rule_add_missing 39 "$WF39"
  rule_add_missing 40 "$WF40"
  rule_remove_stale 39 "$WF39"
  rule_remove_stale 40 "$WF40"

  rm -f "$WF39" "$WF40"
  echo "$NEWHASH" > "$HF"
}

# ---- WAN-политика: устройства → физический WAN-канал, минуя VPN ----
# Аддитивно к VPN-пути. Бэнды ниже 100 и без пересечений: правила prio 60+i,
# таблицы 240+i (i — индекс записи). Без kill-switch: канал лёг → следующее
# правило/основной маршрут (как «использовать соединение» без failover Keenetic).
# NAT/FORWARD ставит invnet-fw.sh (assert_wanpol), персистентность — через NDM-хук.
apply_wan_policy() {
  _t=240; while [ "$_t" -le 249 ]; do ip route flush table "$_t" 2>/dev/null; _t=$((_t+1)); done

  WF_ALL="$RUN/.want_wanpol"
  : > "$WF_ALL"
  if [ -f "$WANPOL" ]; then
    i=0
    jq -c '.[] | select(.enabled != false)' "$WANPOL" 2>/dev/null | while read -r e; do
      WIF=$(echo "$e" | jq -r '.wan // ""')
      if [ -z "$WIF" ] || ! ip link show "$WIF" >/dev/null 2>&1; then i=$((i+1)); continue; fi
      PRIO=$((60 + i)); [ "$PRIO" -gt 69 ] && break   # бэнд 60..69 (≤10 каналов)
      TBL=$((240 + i))
      rpf_ensure_loose "$WIF"   # ослабить строгий rp_filter на канале (с откатом)
      GW=$(wan_gw "$WIF")
      if [ -n "$GW" ]; then
        ip route replace default via "$GW" dev "$WIF" table "$TBL" 2>/dev/null
      else
        ip route replace default dev "$WIF" table "$TBL" 2>/dev/null
      fi
      echo "$e" | jq -r '.devices[]?' | while read -r d; do
        d=$(echo "$d" | tr -d '[:space:]'); [ -z "$d" ] && continue
        echo "$PRIO from $d lookup $TBL"
      done
      i=$((i+1))
    done > "$WF_ALL"
  fi

  EXP_TOTAL=$(grep -c . "$WF_ALL")
  NEWHASH=$(hashof < "$WF_ALL")
  HF="$RUN/.wanpol.applyhash"
  OLDHASH=$(cat "$HF" 2>/dev/null)

  LIVE_TOTAL=0
  p=60
  while [ "$p" -le 69 ]; do
    LIVE_TOTAL=$((LIVE_TOTAL + $(rule_count_at "$p")))
    p=$((p+1))
  done

  if [ "$NEWHASH" = "$OLDHASH" ] && [ "$LIVE_TOTAL" = "$EXP_TOTAL" ]; then
    rm -f "$WF_ALL"
    return 0
  fi

  # разложить по 10 файлам-приоритетам (первое поле WF_ALL — приоритет записи),
  # затем сначала все add, потом все remove — без kill-switch здесь без разницы
  # порядка между записями, но одинаковый принцип упрощает код и хелперы.
  p=60
  while [ "$p" -le 69 ]; do
    awk -v p="$p" '$1==p{$1="";sub(/^ +/,"");print}' "$WF_ALL" > "$RUN/.want_wp_$p"
    p=$((p+1))
  done
  p=60
  while [ "$p" -le 69 ]; do rule_add_missing "$p" "$RUN/.want_wp_$p"; p=$((p+1)); done
  p=60
  while [ "$p" -le 69 ]; do rule_remove_stale "$p" "$RUN/.want_wp_$p"; rm -f "$RUN/.want_wp_$p"; p=$((p+1)); done

  rm -f "$WF_ALL"
  echo "$NEWHASH" > "$HF"
}

# ---- reconcile: факт → желаемое ----
reconcile() {
  for f in "$PROFILES"/*.ovpn; do
    [ -f "$f" ] || continue
    pr=$(basename "$f" .ovpn)
    if is_enabled "$pr"; then start_one "$pr"; else is_running "$pr" && stop_one "$pr"; fi
  done
  # лишние слоты без профиля
  for sf in "$RUN"/*.slot; do
    [ -f "$sf" ] || continue
    pr=$(basename "$sf" .slot)
    [ -f "$PROFILES/$pr.ovpn" ] || stop_one "$pr"
  done
  sleep 1
  apply
}

apply() {
  # сериализуем параллельные apply: два invnet-up.sh при одновременном подъёме
  # туннелей иначе гоняют общие правила (CIDR prio 40). mkdir — атомарный лок,
  # busted через 30с на случай зависшего держателя.
  LOCK="$RUN/.apply.lock"; _n=0
  while ! mkdir "$LOCK" 2>/dev/null; do
    _n=$((_n+1)); [ "$_n" -ge 30 ] && { rmdir "$LOCK" 2>/dev/null; break; }
    sleep 1
  done
  rules_snapshot   # один снимок ip rule на весь вызов — полосы функций не пересекаются
  for sf in "$RUN"/*.slot; do
    [ -f "$sf" ] || continue
    apply_one "$(basename "$sf" .slot)"
  done
  apply_routes
  apply_wan_policy
  invnet_fw_assert_wanpol 2>/dev/null         # NAT/FORWARD для LAN→WAN-канал
  invnet_fw_assert_directroutes 2>/dev/null   # NAT/FORWARD для прямых маршрутов-исключений
  rpf_restore_unused                          # вернуть rp_filter неиспользуемым каналам
  rmdir "$LOCK" 2>/dev/null
}

stopall() {
  for sf in "$RUN"/*.slot; do [ -f "$sf" ] && stop_one "$(basename "$sf" .slot)"; done
}

# ---- расписание (как «Расписание» в Keenetic) ----
# В meta профиля: .schedule = {enabled, actions:[{do:start|stop, hh, mm, dow:[1..7]}]}
# dow: 1=Пн … 7=Вс (date +%u). События edge-triggered: срабатывают в свой момент,
# между событиями ручной тумблер работает как обычно.

sched_now() {
  ND=$(date +%u)
  h=$(date +%H); m=$(date +%M)
  NM=$(( ${h#0} * 60 + ${m#0} ))
}

# Самое недавнее (по времени назад) событие профиля: $1=мета-файл.
# Выводит "do ago_min" события с минимальным ago или ничего, если событий нет.
sched_recent() {
  jq -r --argjson nd "$ND" --argjson nm "$NM" '
    [ .schedule.actions[]? | . as $a | ($a.dow[]?) as $d
      | ((($nd - $d + 7) % 7) * 1440 + ($nm - ($a.hh*60 + $a.mm))) as $ago0
      | {do: $a.do, ago: (if $ago0 < 0 then $ago0 + 10080 else $ago0 end)}
    ] | sort_by(.ago) | if length > 0 then "\(.[0].do) \(.[0].ago)" else empty end
  ' "$1" 2>/dev/null
}

sched_apply_state() {
  # $1=profile $2=start|stop $3=пометка для лога; возвращает 0 если состояние изменили
  cur=$(meta_get "$1" '.enabled'); [ "$cur" = "true" ] || cur=false
  if [ "$2" = "start" ] && [ "$cur" != "true" ]; then
    set_meta_enabled "$1" true
    echo "[$(date '+%F %T')] [расписание] $1 → старт$3" >> "$LOGDIR/invnet-action.log"
    return 0
  elif [ "$2" = "stop" ] && [ "$cur" = "true" ]; then
    set_meta_enabled "$1" false
    echo "[$(date '+%F %T')] [расписание] $1 → стоп$3" >> "$LOGDIR/invnet-action.log"
    return 0
  fi
  return 1
}

schedule_tick() {
  NOW=$(date +%s)
  LAST=$(cat "$RUN/sched.last" 2>/dev/null); [ -z "$LAST" ] && LAST=$((NOW - 30))
  echo "$NOW" > "$RUN/sched.last"
  NOWFLOOR=$(( NOW - NOW % 60 ))
  sched_now
  CH=0
  for f in "$META"/*.json; do
    [ -f "$f" ] || continue
    pr=$(basename "$f" .json)
    [ -f "$PROFILES/$pr.ovpn" ] || continue
    [ "$(jq -r '.schedule.enabled // false' "$f" 2>/dev/null)" = "true" ] || continue
    set -- $(sched_recent "$f")
    [ -z "$1" ] && continue
    # событие сработало, если его минута попала в окно (последний тик, сейчас]
    occ=$(( NOWFLOOR - $2 * 60 ))
    [ "$occ" -gt "$LAST" ] || continue
    sched_apply_state "$pr" "$1" "" && CH=1
  done
  [ "$CH" = 1 ] && reconcile
}

schedule_sync() {
  ONLY=$1
  sched_now
  CH=0
  for f in "$META"/*.json; do
    [ -f "$f" ] || continue
    pr=$(basename "$f" .json)
    [ -n "$ONLY" ] && [ "$pr" != "$ONLY" ] && continue
    [ -f "$PROFILES/$pr.ovpn" ] || continue
    [ "$(jq -r '.schedule.enabled // false' "$f" 2>/dev/null)" = "true" ] || continue
    set -- $(sched_recent "$f")
    [ -z "$1" ] && continue
    sched_apply_state "$pr" "$1" " (синхронизация)" && CH=1
  done
  [ "$CH" = 1 ] && reconcile
  # окно тика сдвигаем только при полном sync (старт демона); per-profile sync
  # из CGI не должен съедать события других профилей, попавшие в это окно
  [ -z "$ONLY" ] && date +%s > "$RUN/sched.last"
  return 0
}

status_json() {
  echo '['
  first=1
  for f in "$PROFILES"/*.ovpn; do
    [ -f "$f" ] || continue
    pr=$(basename "$f" .ovpn)

    # Все поля meta — один jq-вызов
    en=false; wan=""; mode=devices; devc=0; sched=false
    if [ -f "$META/$pr.json" ]; then
      _i=0
      while IFS= read -r _v; do
        _i=$((_i+1))
        case $_i in
          1) en=$_v ;;
          2) wan=$_v ;;
          3) mode=${_v:-devices} ;;
          4) devc=${_v:-0} ;;
          5) sched=$_v ;;
        esac
      done <<_M
$(jq -r '(.enabled//false|tostring), (.wan//""), (.mode//"devices"), (.devices|length//0|tostring), (.schedule.enabled//false|tostring)' "$META/$pr.json" 2>/dev/null)
_M
    fi

    run=false
    _p=$(pid_of "$pr"); [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null && run=true

    # санитизация перед --argjson: битый .slot (гонка записи) или неожиданное
    # значение .enabled/.schedule.enabled в мете иначе валит jq для ОДНОГО профиля,
    # а echo ',' перед вызовом уже напечатан — весь ответ status ломается на всех
    case "$en"    in true|false) : ;; *) en=false ;; esac
    case "$sched" in true|false) : ;; *) sched=false ;; esac
    slot=$(slot_of "$pr")
    case "$slot" in ''|*[!0-9]*) slot="-1" ;; esac
    ip=""
    [ "$run" = true ] && [ "$slot" != "-1" ] && \
      ip=$(ip -br -4 addr show "tun_invnet$slot" 2>/dev/null | awk '{print $3}')
    remote=$(grep -Em1 '^remote ' "$f" 2>/dev/null | awk '{print $2}')

    [ "$first" -eq 0 ] && echo ','
    first=0
    jq -n --arg name "$pr" --arg ip "${ip:-}" --arg remote "${remote:-}" \
          --arg wan "${wan:-}" --arg mode "$mode" \
          --argjson en $en --argjson run $run --argjson slot "${slot:--1}" \
          --argjson devc "${devc:-0}" --argjson sched $sched \
      '{name:$name,enabled:$en,running:$run,slot:$slot,ip:$ip,remote:$remote,wan:$wan,mode:$mode,devices_count:$devc,sched:$sched}'
  done
  echo; echo ']'
}

case "$1" in
  enable)   mkdir -p "$META"; set_meta_enabled "$2" true;  reconcile ;;
  disable)  mkdir -p "$META"; set_meta_enabled "$2" false; reconcile ;;
  reconcile) reconcile ;;
  apply)     apply ;;
  stopall)   stopall ;;
  status)    status_json ;;
  schedule-tick) schedule_tick ;;
  schedule-sync) schedule_sync "$2" ;;
  start-one) start_one "$2"; sleep 1; apply ;;
  stop-one)  stop_one "$2"; apply ;;
  *) echo "usage: $0 {enable|disable|reconcile|apply|stopall|status|schedule-tick|schedule-sync} [profile]"; exit 1 ;;
esac
